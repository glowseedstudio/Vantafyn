<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="320dp"
                android:height="180dp" />
            <gradient
                android:angle="135"
                android:startColor="#0E1320"
                android:centerColor="#070A12"
                android:endColor="#050810"
                android:type="linear" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="120dp"
        android:height="120dp"
        android:drawable="@drawable/vantafyn_logo" />
</layer-list>
