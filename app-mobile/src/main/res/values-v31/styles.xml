        <item name="android:windowActionBar">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">#FF0D0F12</item>
        <item name="android:colorBackground">#FF0D0F12</item>
        <item name="android:colorBackgroundFloating">#FF101622</item>
