<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        HTTP (cleartext) is required for local Jellyfin servers that don't have TLS.
        The Jellyfin SDK prefers HTTPS when the server supports it.
        Tokens are only sent to the user-configured server.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
