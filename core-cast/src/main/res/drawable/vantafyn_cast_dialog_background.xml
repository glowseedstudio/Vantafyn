<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="0"
                android:endColor="#FFB14CFF"
                android:centerColor="#FF735DFF"
                android:startColor="#FF35C7F6"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#FF101622" />
        </shape>
    </item>
</layer-list>
